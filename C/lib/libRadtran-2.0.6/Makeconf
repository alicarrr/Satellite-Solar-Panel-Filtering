INCFLAGS := $(INCFLAGS) -I/usr/include -I/usr/include/hdf5/serial 

ifeq (no,yes)
INCFLAGS       := $(INCFLAGS) 
HAVE_TENSTREAM := -DHAVE_TENSTREAM=0
endif

# If we want to use tenstream lib, we need some external libraries -- foremost petsc and mpi...
ifeq (no,yes)
INCFLAGS := $(INCFLAGS) 
LIBFLAGS := $(LIBFLAGS)  
# Add petsc libs to RPATH of binary
LIBFLAGS := $(LIBFLAGS) -Wl,--disable-new-dtags \
            -Wl,-rpath='$$ORIGIN'/../external/petsc//lib \
            -Wl,-rpath=//lib
endif


# Add external Star-Engine includes and libs
ifeq (no,yes)
HAVE_STARENGINE=-DHAVE_STAR_ENGINE=0
INCFLAGS := $(INCFLAGS) 
LIBFLAGS := $(LIBFLAGS) 
# Add star-engine libs to RPATH of binary
LIBFLAGS := $(LIBFLAGS) -Wl,--disable-new-dtags \
            -Wl,-rpath='$$ORIGIN'/../external/star-engine/lib \
            -Wl,-rpath=/lib
endif

SANITIZE_OPTIONS = 
SANITIZE_COMPILE_OPTIONS = 
SANITIZE_CFLAGS = $(SANITIZE_OPTIONS) $(SANITIZE_COMPILE_OPTIONS)
SANITIZE_LDFLAGS = $(SANITIZE_OPTIONS)

COVERAGE_CFLAGS = 
COVERAGE_LDFLAGS = 

ALL_CFLAGS = $(INCFLAGS) $(DEFS) $(GCC_IEEE_FP_FLAG) $(CFLAGS)\
  $(NANFLAG) \
  $(SANITIZE_OPTIONS) $(SANITIZE_COMPILE_OPTIONS) \
  $(COVERAGE_CFLAGS) \
  $(COMPILING_CONDOR_AT_MIM) \
  $(HAVE_ALIS) \
  $(HAVE_AVHRR) \
  $(HAVE_BAUM) \
  $(HAVE_BAUM_V36) \
  $(HAVE_BRDF) \
  $(HAVE_HEY) \
  $(HAVE_LIBGSL) \
  $(HAVE_LIDAR)\
  $(HAVE_LOWTRAN) \
  $(HAVE_MYSTIC) \
  $(HAVE_MYSTIC3D) \
  $(HAVE_OPENGL) \
  $(HAVE_QDISORT) \
  $(HAVE_SOS)\
  $(HAVE_SSSI) \
  $(HAVE_STARENGINE) \
  $(HAVE_TENSTREAM) \
  $(HAVE_TIPA) \
  $(HAVE_TWOMAXRND3C)\
  $(HAVE_VROOM) \
  $(VERSION)

# Fortran compiler flags.
FFLAGS = -g -O2 -fPIC
FORTRAN_MAIN_FLAG = 

ALL_FFLAGS = $(FFLAGS) \
  $(COVERAGE_CFLAGS)

LDFLAGS =  # User provided LDFLAGS
LD_STATIC_FLAG = 

ALL_LDFLAGS = $(LDFLAGS) \
               \
                \
              $(LIBFLAGS) \
              -L/usr/lib/x86_64-linux-gnu/hdf5/serial -L/usr/lib/x86_64-linux-gnu  \
              $(FORTRAN_MAIN_FLAG) $(FLIBS) \
              $(LD_STATIC_FLAG) \
              $(SANITIZE_LDFLAGS) \
              $(COVERAGE_LDFLAGS) \
              $(LEXLIB) \
              $(LIBGSL) \
              $(LIBGMP) \
              $(LIBOPENGL) \
               -lnetcdf 

# A shell command to extract the version number from version.h.
getversion = sed -e '/version_string/!d' -e 's/[^0-9.]*\([0-9a-z.]*\).*/\1/' -e q 

# Common prefix for installation directories.
# NOTE: This directory must exist when you start installation.
prefix = /usr/local

# Directory in which to put host dependent programs and libraries
exec_prefix = $(prefix)

# Where to install the executables.
bindir = $(exec_prefix)/bin

# Where to put libraries
libdir = $(exec_prefix)/lib

# Where to put extra data files, system-wide startup files, etc.
datadir = $(prefix)/share/libRadtran

# Subdirs of datadir
datasubdirs = atmmod solar

# Where to put extra data files
datafiledir = $(datadir)/data

# Where to put installed include files.
includedir = $(prefix)/include

# Where to put example files
examplesdir = $(datadir)/examples/

# Where to put documentation
docdir = $(datadir)/doc

# Where to put 'info' files
infodir = $(datadir)/info

# The type of computer we are running on.
target_host_type = x86_64-unknown-linux-gnu

# The following pattern rules and the substitution functions require
# GNU make.  If you don't have it, get it!

# Rules for making C source from Fortran source (if necessary).
#
# If we are using f2c there will be a command for the `%.c : %.f'
# pattern and no command for the `%.o : %.f' pattern, so that make
# will not invoke the fortran compiler by mistake.
#
# If we are not using f2c, it should be ok to have an empty rule for
# the pattern `%.c : %.f', but we don't want to replace make's default
# rule for making object from Fortran source files, so there should be
# no pattern or command for that.


%.c : %.f

%.o : %.f Makefile ../Makeconf
	$(ccommand)
	$(FC) -c $(ALL_FFLAGS) $<

# How to make .o files from .c files:
%.o: %.c %.h Makefile ../Makeconf
	$(ccommand)
	$(CC) -c $(CPPFLAGS) $(ALL_CFLAGS) $<
